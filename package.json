{
  "name": "vortex-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Vortex extension exposing an MCP server for programmatic control of Vortex",
  "homepage": "https://github.com/alandtse/vortex-mcp#readme",
  "bugs": "https://github.com/alandtse/vortex-mcp/issues",
  "license": "GPL-3.0-only",
  "author": "Alan Tse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandtse/vortex-mcp.git"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "install-plugin": "node scripts/install-local.mjs",
    "docs:tools": "node scripts/generate-readme-tools-table.mjs",
    "docs:tools:check": "node scripts/generate-readme-tools-table.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "jsdom": "^30.1.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "redux": "4.2.1",
    "tsup": "8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
